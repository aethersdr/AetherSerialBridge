# The Qt and aqt pin, in one place. Read by bash (sourced), CMake (cmake/QtPin.cmake)
# and Python (tools/check_qt_pin.py).
#
# Every CI leg and the build container install exactly this Qt through ci/scripts/install-qt.sh
# (Linux) or the Windows steps in .github/workflows/ci.yml. Workflows and Dockerfiles cannot source
# a file before their own env blocks are evaluated, so they spell the values out;
# tools/check_qt_pin.py fails the static-checks leg the moment any of them disagrees with this file.
# Change the pin HERE first, then update the sites it names.
#
# Format: KEY=value, one per line, no spaces around `=`.

QT_VERSION=6.12.0

# Qt republishes the same version string (RC and final both report 6.12.0). This is the <Version>
# suffix in the repository's Updates.xml; it is part of every Qt cache key.
QT_PACKAGE_REVISION=202609280346

# Floors, MAJOR.MINOR. The GUI is AetherSDR's own window code and needs the Qt AetherSDR ships.
# The headless build (no QtGui, no QtWidgets) accepts what a distro packages (distro-arm leg).
QT_GUI_FLOOR=6.12
QT_HEADLESS_FLOOR=6.4

AQTINSTALL_VERSION=3.3.0
# Windows only: PyPI aqtinstall 3.3.0 cannot read the 6.11+ per-arch Windows repository layout
# (aqtinstall#959, fixed by the unreleased #1000). Drop when aqtinstall > 3.3.0 ships on PyPI.
AQTINSTALL_GIT_REF=076e1659807d0b362a3ed684d54c2e9c775eb9c7
PY7ZR_VERSION=1.1.3
