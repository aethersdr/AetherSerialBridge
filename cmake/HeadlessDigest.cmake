# HeadlessDigest.cmake: the SHA-256 of the finished headless executable, compiled into the GUI.
#
# The Windows GUI installs a copy of the headless executable and must know which bytes it expects
# (WS-7, "install copy with embedded digest"). The digest can only be computed once the headless
# executable is linked, so the GUI target depends on the headless target and includes a header
# generated after it.
#
#   asb_generate_headless_digest(<headless-target> <gui-target>)
#       adds ${CMAKE_BINARY_DIR}/generated/HeadlessDigest.h to <gui-target> and makes it a build
#       dependency. The header defines asb::generated::kHeadlessExeSha256 (64 lowercase hex).
#
#   ASB_HEADLESS_DIGEST_EXE=<file> (cache variable, release packaging only): the digest is taken from that
#       finished executable instead of <headless-target>. The Windows release builds the two executables
#       against two static Qt profiles in two build trees (WS-13): the GUI tree must carry the digest of
#       the headless executable that ships beside it in the zip, not of its own (unshipped) headless
#       target. The release workflow then checks the digest inside the GUI against the zip.
#
# Run as a script (cmake -P) it writes one header:  -DEXE=<file> -DOUT=<header>

if(CMAKE_SCRIPT_MODE_FILE AND CMAKE_SCRIPT_MODE_FILE STREQUAL CMAKE_CURRENT_LIST_FILE)
    cmake_minimum_required(VERSION 3.22)
    if(NOT EXE OR NOT EXISTS "${EXE}")
        message(FATAL_ERROR "HeadlessDigest: EXE missing or not a file: '${EXE}'")
    endif()
    if(NOT OUT)
        message(FATAL_ERROR "HeadlessDigest: OUT not set")
    endif()
    file(SHA256 "${EXE}" _digest)
    string(TOLOWER "${_digest}" _digest)
    string(LENGTH "${_digest}" _len)
    if(NOT _digest MATCHES "^[0-9a-f]+$" OR NOT _len EQUAL 64)
        message(FATAL_ERROR "HeadlessDigest: not a SHA-256 hex digest: '${_digest}'")
    endif()
    # Rewrite only on change, so an unchanged headless executable does not rebuild the GUI.
    set(_body "// Generated by cmake/HeadlessDigest.cmake. Do not edit.\n#pragma once\n\nnamespace asb::generated {\ninline constexpr char kHeadlessExeSha256[] = \"${_digest}\";\n}  // namespace asb::generated\n")
    set(_old "")
    if(EXISTS "${OUT}")
        file(READ "${OUT}" _old)
    endif()
    if(NOT _old STREQUAL _body)
        file(WRITE "${OUT}" "${_body}")
    endif()
    message(STATUS "HeadlessDigest: ${_digest}")
    return()
endif()

set(ASB_HEADLESS_DIGEST_EXE "" CACHE FILEPATH
    "Release packaging: embed the SHA-256 of this headless executable in the GUI instead of the in-tree one")

function(asb_generate_headless_digest headless gui)
    set(header "${CMAKE_BINARY_DIR}/generated/HeadlessDigest.h")
    if(ASB_HEADLESS_DIGEST_EXE)
        if(NOT EXISTS "${ASB_HEADLESS_DIGEST_EXE}")
            message(FATAL_ERROR "ASB_HEADLESS_DIGEST_EXE does not exist: ${ASB_HEADLESS_DIGEST_EXE}")
        endif()
        set(_exe "${ASB_HEADLESS_DIGEST_EXE}")
        set(_dep "${ASB_HEADLESS_DIGEST_EXE}")
    else()
        set(_exe "$<TARGET_FILE:${headless}>")
        set(_dep ${headless})
    endif()
    add_custom_command(
        OUTPUT "${header}"
        COMMAND ${CMAKE_COMMAND} "-DEXE=${_exe}" "-DOUT=${header}"
                -P "${CMAKE_SOURCE_DIR}/cmake/HeadlessDigest.cmake"
        DEPENDS ${_dep}
        COMMENT "Generating HeadlessDigest.h from ${_exe}"
        VERBATIM)
    target_sources(${gui} PRIVATE "${header}")
    target_include_directories(${gui} PRIVATE "${CMAKE_BINARY_DIR}/generated")
    set_source_files_properties("${header}" PROPERTIES GENERATED TRUE)
endfunction()
