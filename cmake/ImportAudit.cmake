# ImportAudit.cmake: the import audit of the executables (WS-1 wiring; WS-7 policy, INV-67, master §4.11).
#
# Windows: `dumpbin /dependents` (static AND delay-load imports) must name only DLLs on the executable's allowlist,
# cmake/ImportAudit.allowlist.<target>.windows.txt: System32 DLLs and API sets (`*` globs allowed). A dynamic-Qt
# development build also imports the Qt and MSVC runtime DLLs from the build tree; they are tolerated only when
# -DQT_SHARED=ON (the shipped executables link Qt and the CRT statically, D3, and WS-13 audits those). When the
# target carries the DLL policy (asb_apply_dll_policy), `dumpbin /loadconfig` must show the dependent load flag
# 0x800. ELF (Linux): report-only (the policy is a Windows one).
#
#   asb_add_import_audit(<target>)        CTest "ImportAudit.<target>"
#
# Script mode (cmake -P):  -DEXE=<file> [-DDUMPBIN=<dumpbin>|-DREADELF=<readelf>] [-DALLOWLIST=<file>]
#                          [-DQT_SHARED=ON] [-DLOADFLAG=ON]
#
# An ALLOWLIST that exists and has at least one entry turns the report into a check.

if(CMAKE_SCRIPT_MODE_FILE AND CMAKE_SCRIPT_MODE_FILE STREQUAL CMAKE_CURRENT_LIST_FILE)
    cmake_minimum_required(VERSION 3.22)
    if(NOT EXE OR NOT EXISTS "${EXE}")
        message(FATAL_ERROR "ImportAudit: EXE missing or not a file: '${EXE}'")
    endif()
    set(_imports "")
    if(WIN32)
        if(NOT DUMPBIN)
            message(FATAL_ERROR "ImportAudit: -DDUMPBIN is required on Windows")
        endif()
        execute_process(COMMAND "${DUMPBIN}" /nologo /dependents "${EXE}"
                        OUTPUT_VARIABLE _out RESULT_VARIABLE _rc ERROR_VARIABLE _err)
        if(NOT _rc EQUAL 0)
            message(FATAL_ERROR "ImportAudit: dumpbin failed (${_rc}): ${_err}")
        endif()
        string(REGEX MATCHALL "[A-Za-z0-9_.+-]+\\.dll" _imports "${_out}")
    else()
        if(NOT READELF)
            message(FATAL_ERROR "ImportAudit: -DREADELF is required on ELF platforms")
        endif()
        execute_process(COMMAND "${READELF}" -d "${EXE}"
                        OUTPUT_VARIABLE _out RESULT_VARIABLE _rc ERROR_VARIABLE _err)
        if(NOT _rc EQUAL 0)
            message(FATAL_ERROR "ImportAudit: readelf failed (${_rc}): ${_err}")
        endif()
        string(REGEX MATCHALL "Shared library: \\[[^]]+\\]" _imports "${_out}")
        list(TRANSFORM _imports REPLACE "Shared library: \\[([^]]+)\\]" "\\1")
    endif()
    list(REMOVE_DUPLICATES _imports)
    list(SORT _imports)
    get_filename_component(_name "${EXE}" NAME)
    message(STATUS "ImportAudit: ${_name} imports ${_imports}")

    set(_allow "")
    if(ALLOWLIST AND EXISTS "${ALLOWLIST}")
        file(STRINGS "${ALLOWLIST}" _lines)
        foreach(_l IN LISTS _lines)
            string(STRIP "${_l}" _l)
            if(_l AND NOT _l MATCHES "^#")
                list(APPEND _allow "${_l}")
            endif()
        endforeach()
    endif()
    if(NOT _allow)
        message(STATUS "ImportAudit: REPORT-ONLY (no allowlist yet; WS-7 populates it)")
        return()
    endif()
    if(QT_SHARED)
        list(APPEND _allow "qt6*.dll" "msvcp140*.dll" "vcruntime140*.dll" "concrt140.dll")
        message(STATUS "ImportAudit: dynamic-Qt build: the Qt and MSVC runtime DLLs are tolerated")
    endif()
    string(TOLOWER "${_allow}" _allow)
    set(_bad 0)
    foreach(_i IN LISTS _imports)
        string(TOLOWER "${_i}" _il)
        set(_ok FALSE)
        foreach(_a IN LISTS _allow)
            string(REPLACE "." "\\." _re "${_a}")
            string(REPLACE "*" ".*" _re "${_re}")
            if(_il MATCHES "^${_re}$")
                set(_ok TRUE)
                break()
            endif()
        endforeach()
        if(NOT _ok)
            message(SEND_ERROR "ImportAudit: ${_name} imports '${_i}', which is not in the allowlist")
            set(_bad 1)
        endif()
    endforeach()
    if(LOADFLAG AND WIN32)
        execute_process(COMMAND "${DUMPBIN}" /nologo /loadconfig "${EXE}" OUTPUT_VARIABLE _lc RESULT_VARIABLE _rc)
        if(NOT _lc MATCHES "0800 Dependent Load Flag")
            message(SEND_ERROR "ImportAudit: ${_name} does not carry /DEPENDENTLOADFLAG:0x800")
            set(_bad 1)
        else()
            message(STATUS "ImportAudit: ${_name} carries the dependent load flag 0x800")
        endif()
    endif()
    if(NOT _bad)
        message(STATUS "ImportAudit: OK ${_name}")
    endif()
    return()
endif()

find_program(ASB_READELF NAMES readelf)
if(WIN32)
    get_filename_component(_asb_ia_linker_dir "${CMAKE_LINKER}" DIRECTORY)
    find_program(ASB_DUMPBIN NAMES dumpbin HINTS "${_asb_ia_linker_dir}")
endif()

# `ALLOWLIST_OF <name>` audits <target> against another executable's allowlist (the control); the CTest is then
# named ImportAudit.<target>.
function(asb_add_import_audit target)
    cmake_parse_arguments(ARG "" "ALLOWLIST_OF" "" ${ARGN})
    set(_list_name ${target})
    if(ARG_ALLOWLIST_OF)
        set(_list_name ${ARG_ALLOWLIST_OF})
    endif()
    set(args "-DEXE=$<TARGET_FILE:${target}>")
    if(WIN32)
        list(APPEND args "-DDUMPBIN=${ASB_DUMPBIN}"
                         "-DALLOWLIST=${CMAKE_SOURCE_DIR}/cmake/ImportAudit.allowlist.${_list_name}.windows.txt")
        asb_qt_is_static(_static)
        if(NOT _static)
            list(APPEND args "-DQT_SHARED=ON")
        endif()
        get_target_property(_policy ${target} ASB_DLL_POLICY)
        if(_policy)
            list(APPEND args "-DLOADFLAG=ON")
        endif()
        set(_labels "import-audit")
    else()
        list(APPEND args "-DREADELF=${ASB_READELF}")
        set(_labels "import-audit;report-only")
    endif()
    add_test(NAME ImportAudit.${target}
             COMMAND ${CMAKE_COMMAND} ${args} -P "${CMAKE_SOURCE_DIR}/cmake/ImportAudit.cmake")
    set_tests_properties(ImportAudit.${target} PROPERTIES LABELS "${_labels}")
endfunction()
