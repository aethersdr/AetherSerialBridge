+
+bool ThemeManager::activateValidatedTheme(const QString& name, const QByteArray& json)
+{
+    // Exactly these bytes: nothing is re-read from a path, so a file replaced
+    // after the caller validated it has no effect. Always reloads (the same name
+    // may carry different bytes), and touches no AppSettings, no m_themePaths and
+    // no file. A failed load leaves the previous theme fully in place.
+    if (!loadThemeFromJson(json, QStringLiteral("validated theme ") + name)) return false;
+    m_activeTheme = name;
+    emit themeChanged();
+    return true;
+}
