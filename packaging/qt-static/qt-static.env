# Static Qt from source (WS-13; master D3, section 9). Read by bash (sourced), PowerShell
# (packaging/qt-static/build-qt-static.ps1) and tools/check_qt_pin.py.
#
# The version is cmake/qt-pin.env's QT_VERSION: tools/check_qt_pin.py fails when the archive names below
# do not carry it. The SHA-256 values are the ones download.qt.io publishes beside each archive (checked
# against the downloaded bytes when they were pinned); the build scripts refuse an archive that does not
# match. Linux builds from the .tar.xz, Windows from the .zip (Qt's own split).
#
# Format: KEY=value, one per line, no spaces around `=`.

QT_STATIC_BASE_URL=https://download.qt.io/archive/qt/6.12/6.12.0/submodules

QTBASE_TAR=qtbase-everywhere-src-6.12.0.tar.xz
QTBASE_TAR_SHA256=a951bd163c7b80fc6b8c88d7668fb56abf91c152373e13c10666763238131307
QTSERIALPORT_TAR=qtserialport-everywhere-src-6.12.0.tar.xz
QTSERIALPORT_TAR_SHA256=ba8886a54eee466e57c9fa1341255cc09c462c84baab3ee7b19d67cdbcbd71c3

QTBASE_ZIP=qtbase-everywhere-src-6.12.0.zip
QTBASE_ZIP_SHA256=0529901575c413e34ded504eeda177c4a6dfd0dff1e39ed52c811dc5204b43c7
QTSERIALPORT_ZIP=qtserialport-everywhere-src-6.12.0.zip
QTSERIALPORT_ZIP_SHA256=9a3643a0ff36ca2370ca91e8a995b2f11f8ef09a3a23f2c3ae78de3d6c96248e
