# RunProbe.cmake (WS-7, INV-67): copies EXE and the planted VERSION.dll into a fresh directory and runs EXE there.
#   -DEXE=<probe> -DPLANT=<plant dll> -DWORK=<directory> -DEXPECT=plant|system
cmake_minimum_required(VERSION 3.22)
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}")
get_filename_component(_name "${EXE}" NAME)
file(COPY_FILE "${EXE}" "${WORK}/${_name}")
file(COPY_FILE "${PLANT}" "${WORK}/VERSION.dll")
execute_process(COMMAND "${WORK}/${_name}" WORKING_DIRECTORY "${WORK}" OUTPUT_VARIABLE _out RESULT_VARIABLE _rc)
message(STATUS "${_out}")
if(NOT _rc EQUAL 0)
    message(FATAL_ERROR "dllprobe: ${_name} exited ${_rc}")
endif()
string(REGEX MATCH "loaded from: ([^\r\n]*)" _m "${_out}")
set(_from "${CMAKE_MATCH_1}")
string(TOLOWER "${_from}" _from_l)
file(TO_NATIVE_PATH "${WORK}" _work_n)
string(TOLOWER "${_work_n}" _work_l)
string(FIND "${_from_l}" "${_work_l}" _in_work)
string(FIND "${_from_l}" "\\system32\\" _in_sys)
if(EXPECT STREQUAL "plant")
    if(NOT _in_work EQUAL 0)
        message(FATAL_ERROR "dllprobe: expected the planted DLL from ${WORK}, got '${_from}'")
    endif()
    message(STATUS "dllprobe: PLANT LOADED (positive control)")
else()
    if(_in_sys LESS 0)
        message(FATAL_ERROR "dllprobe: expected System32's VERSION.dll, got '${_from}'")
    endif()
    message(STATUS "dllprobe: SYSTEM32 LOADED (mitigated)")
endif()
