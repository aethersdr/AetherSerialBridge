# ProcessCreationAudit.cmake (WS-9, INV-112, S17): no product object may reference a process-creation function.
#
#   cmake -DEXE=<file> -DMODE=check|control [-DTEST_NAME=<name>] [-DALLOWED=<object>|<symbol regex>,...]
#         ELF:     -DMAP=<GNU ld map> -DNM=<nm> -DBINARY_DIR=<dir the map's relative paths start from>
#         Windows: -DOBJECTS=<file listing the .obj files, one per line> -DDUMPBIN=<dumpbin>
#         -P ProcessCreationAudit.cmake
#
# Forbidden (master §4.6 "Process creation"): fork, vfork, clone, clone3, the exec family, fexecve, system, popen,
# posix_spawn[p], raw syscall (the INV-112 grep rule's symbol twin); Windows CreateProcess*, ShellExecute*, WinExec,
# _spawn*/_wspawn*, _popen/_wpopen, system/_wsystem; and any QProcess:: member, on every OS.
#
# Two layers, each over what the linker actually used:
#   objects     ELF: every object and archive the link map LOADs (the executable's own objects, the bridge
#               libraries, any static third-party archive; the toolchain's crt files and system libraries are
#               skipped), `nm -A -C -u`. Windows: the listed .obj files (a .res is
#               skipped; at least one object must be read), `dumpbin /symbols`, UNDEF externals.
#   executable  the finished binary's imports (`nm -D -u -C`; `dumpbin /imports`): catches a static archive the
#               object layer was not told about. A name is excused here only if an allowed object references it.
# ALLOWED entries "<object file name>|<symbol regex>" excuse exactly that symbol in that object: ProcessGuard.cpp's
# seccomp syscall, and a test build's GuardProbe.cpp (guard_installed_before_first_object). The Linux GUI's
# gui/PkexecClient.cpp (WS-9b/WS-10) and Windows' platform/win/SelfElevate.cpp (ShellExecuteExW, WS-16 D64) are the
# others; the controls (process_creation_audit_control, shellexecute_control) prove an object elsewhere is reported.
# MODE=check fails ("ProcessCreationAudit: VIOLATION") on any finding; MODE=control fails unless the object layer
# finds one (the control object calls QProcess::start). A missing input or tool is an error, never a pass. With
# -DTEST_NAME=<name>, a violation also prints QtTest's "FAIL!  : <name>()" line, so a run log names the check.
cmake_minimum_required(VERSION 3.22)

if(NOT EXE OR NOT EXISTS "${EXE}")
    message(FATAL_ERROR "ProcessCreationAudit: EXE missing: '${EXE}'")
endif()
if(NOT MODE)
    set(MODE check)
endif()
string(REPLACE "," ";" ALLOWED "${ALLOWED}")

set(_c_names "fork|vfork|clone|clone3|execv|execve|execvp|execvpe|execl|execlp|execle|execveat|fexecve|system|popen|posix_spawn|posix_spawnp|syscall")
set(_win_names "CreateProcess[A-Za-z]*|ShellExecute[A-Za-z]*|WinExec|_w?spawn[a-z]*|_w?popen|_wsystem|system")
# A symbol as nm/dumpbin print it, version suffix and import prefix removed, is forbidden when it is one of the C/Win32
# names exactly, or names a QProcess member.
function(_forbidden sym out)
    string(REGEX REPLACE "@.*$" "" s "${sym}")
    string(REGEX REPLACE "^__imp_" "" s "${s}")
    string(STRIP "${s}" s)
    if(s MATCHES "^(${_c_names})$" OR s MATCHES "^(${_win_names})$" OR s MATCHES "QProcess::" OR s MATCHES "@QProcess@@")
        set(${out} "${s}" PARENT_SCOPE)
    else()
        set(${out} "" PARENT_SCOPE)
    endif()
endfunction()

# Is `sym` in object `obj` excused by ALLOWED?
function(_allowed obj sym out)
    get_filename_component(base "${obj}" NAME)
    set(ok OFF)
    foreach(entry IN LISTS ALLOWED)
        string(FIND "${entry}" "|" bar)
        if(bar LESS 0)
            continue()
        endif()
        string(SUBSTRING "${entry}" 0 ${bar} o)
        math(EXPR rest "${bar} + 1")
        string(SUBSTRING "${entry}" ${rest} -1 r)
        if(base STREQUAL o AND sym MATCHES "^(${r})$")
            set(ok ON)
        endif()
    endforeach()
    set(${out} ${ok} PARENT_SCOPE)
endfunction()

set(_violations "")
set(_excused "")      # forbidden names an allowed object references (excused in the executable layer)
set(_objects_found OFF)

if(DUMPBIN)
    # ---- Windows ----------------------------------------------------------------------------------------
    if(NOT OBJECTS OR NOT EXISTS "${OBJECTS}")
        message(FATAL_ERROR "ProcessCreationAudit: OBJECTS missing: '${OBJECTS}'")
    endif()
    file(STRINGS "${OBJECTS}" _objs)
    set(_objects_read 0)
    foreach(obj IN LISTS _objs)
        if(NOT obj)
            continue()
        endif()
        # A compiled resource (.res, the application icon) holds only resources: it cannot reference process creation,
        # and it is not a COFF object dumpbin /symbols can read.
        if(obj MATCHES "\\.res$")
            continue()
        endif()
        math(EXPR _objects_read "${_objects_read} + 1")
        execute_process(COMMAND "${DUMPBIN}" /nologo /symbols "${obj}" OUTPUT_VARIABLE out RESULT_VARIABLE rc ERROR_QUIET)
        if(NOT rc EQUAL 0)
            message(FATAL_ERROR "ProcessCreationAudit: dumpbin /symbols failed on ${obj}")
        endif()
        string(REPLACE "\n" ";" lines "${out}")
        foreach(line IN LISTS lines)
            if(NOT line MATCHES "UNDEF .*External +\\| +([^ ]+)( \\((.*)\\))?")
                continue()
            endif()
            set(raw "${CMAKE_MATCH_1}")
            set(demangled "${CMAKE_MATCH_3}")
            _forbidden("${raw}" name)
            if(NOT name AND demangled)
                _forbidden("${demangled}" name)
            endif()
            if(name)
                _allowed("${obj}" "${name}" ok)
                if(ok)
                    list(APPEND _excused "${name}")
                else()
                    get_filename_component(b "${obj}" NAME)
                    list(APPEND _violations "${b}: ${name}")
                    set(_objects_found ON)
                endif()
            endif()
        endforeach()
    endforeach()
    if(_objects_read EQUAL 0)
        message(FATAL_ERROR "ProcessCreationAudit: no object file to read in ${OBJECTS}")
    endif()
    execute_process(COMMAND "${DUMPBIN}" /nologo /imports "${EXE}" OUTPUT_VARIABLE out RESULT_VARIABLE rc ERROR_QUIET)
    if(NOT rc EQUAL 0)
        message(FATAL_ERROR "ProcessCreationAudit: dumpbin /imports failed on ${EXE}")
    endif()
    string(REPLACE "\n" ";" lines "${out}")
    foreach(line IN LISTS lines)
        if(line MATCHES "^ +[0-9A-Fa-f]+ +([A-Za-z_][A-Za-z0-9_@?$]*) *$")
            _forbidden("${CMAKE_MATCH_1}" name)
            if(name AND NOT name IN_LIST _excused)
                list(APPEND _violations "imports ${name}")
            endif()
        endif()
    endforeach()
else()
    # ---- ELF ----------------------------------------------------------------------------------------------
    if(NOT NM OR NOT MAP OR NOT EXISTS "${MAP}")
        message(FATAL_ERROR "ProcessCreationAudit: NM and MAP are required on ELF platforms ('${NM}', '${MAP}')")
    endif()
    file(STRINGS "${MAP}" _loads REGEX "^LOAD ")
    set(_inputs "")
    foreach(l IN LISTS _loads)
        string(REGEX REPLACE "^LOAD " "" p "${l}")
        if(p MATCHES "\\.so(\\.[0-9.]*)?$" OR p MATCHES "^/(usr/)?lib(32|64)?/" OR p MATCHES "^-l")
            continue()   # shared libraries (their own imports are not ours), the toolchain's crt files and libc
        endif()
        if(p STREQUAL "linker stubs")
            continue()   # GNU ld's own stubs (seen on the arm64 leg): a synthetic input, not a file
        endif()
        if(NOT IS_ABSOLUTE "${p}")
            set(p "${BINARY_DIR}/${p}")
        endif()
        list(APPEND _inputs "${p}")
    endforeach()
    list(REMOVE_DUPLICATES _inputs)
    if(NOT _inputs)
        message(FATAL_ERROR "ProcessCreationAudit: the map ${MAP} LOADs no objects")
    endif()
    foreach(obj IN LISTS _inputs)
        if(NOT EXISTS "${obj}")
            message(FATAL_ERROR "ProcessCreationAudit: input missing: ${obj}")
        endif()
        execute_process(COMMAND "${NM}" -A -C -u "${obj}" OUTPUT_VARIABLE out RESULT_VARIABLE rc ERROR_QUIET)
        if(NOT rc EQUAL 0)
            message(FATAL_ERROR "ProcessCreationAudit: nm failed on ${obj}")
        endif()
        string(REPLACE "\n" ";" lines "${out}")
        foreach(line IN LISTS lines)
            # "file.o:   U sym" or "lib.a:member.o:   U sym"
            if(NOT line MATCHES "^(.*):[ \t]+U (.*)$")
                continue()
            endif()
            set(where "${CMAKE_MATCH_1}")
            set(sym "${CMAKE_MATCH_2}")
            _forbidden("${sym}" name)
            if(NOT name)
                continue()
            endif()
            string(REGEX REPLACE "^.*:" "" member "${where}")   # the member (or the object itself)
            _allowed("${member}" "${name}" ok)
            if(ok)
                list(APPEND _excused "${name}")
            else()
                list(APPEND _violations "${where}: ${name}")
                set(_objects_found ON)
            endif()
        endforeach()
    endforeach()
    execute_process(COMMAND "${NM}" -D -u -C "${EXE}" OUTPUT_VARIABLE out RESULT_VARIABLE rc ERROR_QUIET)
    if(NOT rc EQUAL 0)
        message(FATAL_ERROR "ProcessCreationAudit: nm -D failed on ${EXE}")
    endif()
    string(REPLACE "\n" ";" lines "${out}")
    foreach(line IN LISTS lines)
        if(line MATCHES "^[ \t]+U (.*)$")
            _forbidden("${CMAKE_MATCH_1}" name)
            if(name AND NOT name IN_LIST _excused)
                list(APPEND _violations "imports ${name}")
            endif()
        endif()
    endforeach()
endif()

get_filename_component(_name "${EXE}" NAME)
list(REMOVE_DUPLICATES _violations)
if(MODE STREQUAL "check")
    if(_violations)
        foreach(v IN LISTS _violations)
            message("ProcessCreationAudit: VIOLATION: ${_name}: ${v}")
        endforeach()
        if(TEST_NAME)
            list(GET _violations 0 _first)
            message("FAIL!  : ${TEST_NAME}() ${_name} references process creation (${_first})")
        endif()
        message(FATAL_ERROR "ProcessCreationAudit: ${_name} references process creation (INV-112)")
    endif()
    message(STATUS "ProcessCreationAudit: OK: ${_name}")
else()
    if(NOT _objects_found)
        message(FATAL_ERROR "ProcessCreationAudit: CONTROL NOT DETECTED in ${_name}")
    endif()
    foreach(v IN LISTS _violations)
        message(STATUS "ProcessCreationAudit: control finding: ${v}")
    endforeach()
    message(STATUS "ProcessCreationAudit: control ${_name} detected")
endif()
