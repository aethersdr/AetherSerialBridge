{
  "schemaVersion": 2,
  "name": "ASB Fixture",
  "scopes": {
    "root": {
      "tokens": {
        "gradient": {
          "panel": {
            "type": "conic-gradient",
            "angle": 180,
            "stops": [
              {
                "at": 0,
                "color": "#112233"
              },
              {
                "at": 1,
                "color": "{color.blue.500}"
              }
            ]
          }
        }
      }
    }
  }
}
